# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# DO NOT commit .streamlit/secrets.toml to version control!

# 1. Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# 2. Gmail SMTP Credentials for sending deadline reminders
# Follow these 2 steps on your Google Account:
#   Step A: Enable 2-Step Verification at https://myaccount.google.com/security
#   Step B: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
#           (Select app: 'Mail', device: 'Other (Streamlit App)')
# Use the generated 16-character App Password (without spaces) below:
GMAIL_ADDRESS = "your_email@gmail.com"
GMAIL_APP_PASSWORD = "your_16_character_app_password"
